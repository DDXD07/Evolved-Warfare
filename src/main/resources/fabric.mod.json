{
	"schemaVersion": 1,
	"id": "evolvedwarfare",
	"version": "${version}",
	"name": "Evolved Warfare",
	"description": "NPCs, ejércitos, trabajadores, comercio, facciones, asedio, armas medievales e investigación para Minecraft 1.21.1. Inspirado en Ancient Warfare.",
	"license": "MIT",
	"icon": "assets/evolvedwarfare/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.evolvedwarfare.EvolvedWarfare"
		],
		"client": [
			"com.evolvedwarfare.client.EvolvedWarfareClient"
		],
		"modmenu": [
			"com.evolvedwarfare.client.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"evolvedwarfare.mixins.json",
		{
			"config": "evolvedwarfare.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
